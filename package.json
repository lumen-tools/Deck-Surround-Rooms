  },
  "homepage": "https://github.com/lumen-tools/Deck-Surround-Rooms#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
